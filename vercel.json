{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "shop.autism.info.bd"
        }
      ],
      "destination": "/shop.html"
    },
    {
      "source": "/:match*",
      "has": [
        {
          "type": "host",
          "value": "shop.autism.info.bd"
        }
      ],
      "destination": "/shop.html"
    }
  ]
}
