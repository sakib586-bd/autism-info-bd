{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "shop.autism.info.bd"
        }
      ],
      "destination": "/shop"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shop.autism.info.bd"
        }
      ],
      "destination": "/shop/:path*"
    }
  ]
}
